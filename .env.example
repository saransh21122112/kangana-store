# Copy this file to `.env` (for `next dev` / Prisma CLI) and fill in real
# values. Never commit the real `.env` — it's gitignored.
#
# For local Docker Desktop use (`docker compose up`), the same `.env` file
# is read via docker-compose.yml's `env_file`.
#
# DATABASE_URL / DATABASE_URL_UNPOOLED come from the Neon Postgres instance
# provisioned via the Vercel Marketplace (see MEMORY.md Stage 0) — grab the
# pooled and direct/unpooled connection strings from the Vercel dashboard's
# Storage tab, or `vercel env pull`.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth v5. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"
# Local dev / Docker: http://localhost:3000
# Production (Vercel): your deployed https:// URL
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp integration mode: "link" (wa.me deep links, no API keys needed)
# or "cloud" (WhatsApp Cloud API — not implemented yet, see MEMORY.md Stage 6).
WHATSAPP_MODE=link
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Bearer token required on the `Authorization` header of
# GET /api/cron/daily-check (Vercel Cron uses this automatically once set as
# a project env var; generate with: openssl rand -hex 16)
CRON_SECRET="replace-with-a-generated-secret"
