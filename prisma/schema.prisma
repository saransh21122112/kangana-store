// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                String       @id @default(cuid())
  name              String
  mobileNumber      String       @unique
  birthday          DateTime?
  anniversary       DateTime?
  areaLocality      String?
  gender            Gender?
  customerSince     DateTime     @default(now())
  loyaltyPoints     Int          @default(0)
  favouriteCategory String?
  notes             String?
  bills             Bill[]
  messagesLog       MessageLog[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  totalPurchaseAmount Float     @default(0)
  totalVisits         Int       @default(0)
  averageBillValue    Float     @default(0)
  lastVisitDate       DateTime?

  @@index([lastVisitDate])
  @@index([totalPurchaseAmount])
  @@index([birthday])
  @@index([anniversary])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model Bill {
  id         String   @id @default(cuid())
  billNo     String   @unique
  date       DateTime @default(now())
  // Sum of lineItems' lineTotal at creation time — NOT reduced by later
  // returns (BillReturn rows track those separately). Use each
  // BillLineItem's net-of-returns total, or recalculateCustomerRollup's
  // logic, for a customer's real current spend.
  amount     Float
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  createdAt  DateTime @default(now())

  // Header row over the actual purchased things (Stage 21) — each with its
  // own category/optional stocked item/quantity/price. Replaced Bill's
  // original flat category/inventoryItemId/quantitySold columns, removed
  // in the migration that added this comment once every query/UI path was
  // rewritten and verified against the 100 pre-existing bills backfilled
  // into this table.
  lineItems BillLineItem[]

  @@index([date])
}

model MessageTemplate {
  id        String      @id @default(cuid())
  type      MessageType
  title     String
  body      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum MessageType {
  BIRTHDAY
  ANNIVERSARY
  FESTIVAL
  NEW_ARRIVALS
  MONTHLY_OFFER
  WE_MISS_YOU
  CUSTOM
}

model MessageLog {
  id         String        @id @default(cuid())
  customer   Customer      @relation(fields: [customerId], references: [id])
  customerId String
  type       MessageType
  bodySent   String
  status     MessageStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([status])
  @@index([type])
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

model OwnerNotification {
  id        String   @id @default(cuid())
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  activityLogs ActivityLog[]
  billReturns  BillReturn[]
}

enum Role {
  OWNER
  STAFF
  VIEWER
}

// --- Stage 9 addition ------------------------------------------------------
// The ONE schema exception in this project's build: every prior stage was
// told not to touch schema.prisma, specifically to avoid stepping on the
// datasource/generator blocks and existing models. Stage 9 (Settings) needs
// genuinely persisted app-wide settings (store profile, categories,
// thresholds) and there is no existing table that can hold them without a
// migration, so this single new model was added — additive only, no
// existing model/datasource/generator block touched. See MEMORY.md's
// "Stage 9 — Settings" section for the full rationale.
model AppSettings {
  id                    String   @id @default("singleton")
  storeName             String   @default("Kangna Beauty & Jewellery")
  logoUrl               String?
  accentColor           String   @default("#0A84FF")
  categories            String[] @default(["Jewellery", "Bangles", "Makeup", "Innerwear", "Handbag", "Bridal Package", "Skincare", "Accessories", "Other"])
  inactiveThreshold30   Int      @default(30)
  inactiveThreshold60   Int      @default(60)
  inactiveThreshold90   Int      @default(90)
  /**
   * Loyalty points earned per rupee spent, e.g. 0.01 = 1 point per ₹100.
   * Configurable rather than fixed (Stage 21) so the store can tune it
   * without a code change.
   */
  loyaltyPointsPerRupee Float    @default(0.01)
  updatedAt             DateTime @updatedAt
}

// --- Stage 19 addition ------------------------------------------------------
// Standalone inventory tracker — not linked to Bill (bills stay purely
// label-based via their free-text `category` string, per the explicit scope
// decision for this stage). Additive only, same "one new model" precedent as
// AppSettings above.
model InventoryItem {
  id                String         @id @default(cuid())
  name              String
  category          String
  /**
   * Brand/manufacturer (e.g. "LAKME", "SUGAR") — distinct from `category`,
   * which stays one of the store's broad reporting buckets (Makeup, Skincare,
   * etc.) so the dashboard's category chart doesn't explode into one slice
   * per brand. Used for search/filtering only.
   */
  brand             String?
  /**
   * Selling unit ("Pcs", "Box", "Dozen", "PKT", "Set") — how `ratePerUnit`
   * is priced. Editable later; not enforced against an enum since a store
   * may introduce new units.
   */
  unitType          String         @default("Pcs")
  /**
   * Price per `unitType`. Defaults to 0 for bulk-imported items with no
   * source price yet — filled in later via the Inventory page.
   */
  ratePerUnit       Float          @default(0)
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(5)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lineItems         BillLineItem[]

  @@index([category])
  @@index([brand])
}

// --- Stage 21 addition ------------------------------------------------------
// Bill line items: a Bill becomes a header record; the actual purchased
// things (each with its own category/optional stocked item/quantity/price)
// live here, one-to-many. Replaces Bill's old single category/amount/
// inventoryItemId/quantitySold shape — see the migration note on `Bill`
// below for how the 100 pre-existing bills were carried over.
//
// Pricing: either `unitPrice` is set (and `lineTotal = unitPrice * quantity`)
// or a flat `lineTotal` is entered directly with `unitPrice` left null —
// staff's choice per line, per the explicit brief for this stage. Whichever
// is provided, `lineTotal` is always the stored, authoritative amount for
// that line (never recomputed from `unitPrice` after the fact), since a
// later partial return needs a stable per-line total to prorate against.
model BillLineItem {
  id              String         @id @default(cuid())
  bill            Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId          String
  category        String
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String?
  quantity        Int            @default(1)
  unitPrice       Float?
  lineTotal       Float
  createdAt       DateTime       @default(now())

  returns BillReturn[]

  @@index([billId])
  @@index([inventoryItemId])
}

// Partial or full returns against a specific line item (not the bill as a
// whole) — a "full bill return" is just returning every one of its line
// items. `quantityReturned` and `amountReturned` are validated against the
// line item's remaining not-yet-returned quantity/amount in
// `lib/queries/bills.ts`, not at the DB level. Restoring inventory stock
// (if the line item has one) and clawing back loyalty points earned from
// this line's share of the original sale both happen atomically alongside
// creating this row.
model BillReturn {
  id               String       @id @default(cuid())
  lineItem         BillLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  lineItemId       String
  quantityReturned Int
  amountReturned   Float
  reason           String?
  createdAt        DateTime     @default(now())
  createdBy        User?        @relation(fields: [createdById], references: [id])
  createdById      String?

  @@index([lineItemId])
}

// Who-did-what audit trail (OWNER-only visibility) for Customer/Bill
// mutations. Deliberately its own table rather than createdBy/updatedBy
// columns bolted onto Customer/Bill — keeps every action (create, each
// edit, delete) as its own timestamped row instead of only ever knowing
// the *last* actor. `userEmail` is a denormalized snapshot of the acting
// user at the time of the action, so a log entry stays meaningful even if
// that User account is later deleted (`userId` alone would go null).
model ActivityLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
